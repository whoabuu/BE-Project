generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  RECRUITER
  TPO
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum EducationLevel {
  SSC
  HSC
  DIPLOMA
  BACHELORS
  MASTERS
  PHD
}

enum ExperienceType {
  INTERNSHIP
  FULL_TIME
  PART_TIME
  FREELANCE
}

enum ProfileVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ResumeStatus {
  UPLOADED
  ANALYZING
  ANALYZED
  FAILED
}

enum AssessmentType {
  DSA
  APTITUDE
}

enum AssessmentStatus {
  DRAFT
  GENERATED
  VALIDATED
  PUBLISHED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum AssessmentQuestionType {
  MCQ
  CODING
}

enum AssessmentQuestionStatus {
  GENERATED
  VALIDATED
  REJECTED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AptitudeSection {
  QUANTITATIVE
  LOGICAL
  VERBAL
  TECHNICAL
}

enum AssessmentAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  TERMINATED
}

enum SubmissionReason {
  MANUAL
  TIME_EXPIRED
  PROCTORING_VIOLATION
}

enum ProctoringEventType {
  TAB_SWITCH
  WINDOW_BLUR
  VISIBILITY_CHANGE
  FULLSCREEN_EXIT
  CAMERA_LOST
  MICROPHONE_LOST
  OTHER
}

enum CodingSubmissionStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  ERROR
  TIME_LIMIT
  MEMORY_LIMIT
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  role         Role   @default(STUDENT)

  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   StudentProfile?
  recruiter RecruiterProfile?
  tpo       TPOProfile?
}

model StudentProfile {
  id          String @id @default(uuid())
  studentCode String @unique

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName  String?
  middleName String?
  lastName   String?

  dateOfBirth DateTime?
  gender      Gender?

  profilePhoto String?

  phone          String?
  alternatePhone String?

  nationality   String?
  domicileState String?

  bio String?

  collegeName      String?
  universityName   String?
  branch           String?
  enrollmentNumber String?
  graduationYear   Int?

  profileCompleted Int @default(0)

  verificationStatus ProfileVerificationStatus @default(PENDING)
  verificationNote   String?
  verifiedAt         DateTime?
  verifiedByTpoId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses          Address[]
  educations         Education[]
  skills             StudentSkill[]
  projects           Project[]
  experiences        Experience[]
  certifications     Certification[]
  achievements       Achievement[]
  socialLinks        SocialLink[]
  resumes            Resume[]
  preferences        PlacementPreference?
  assessmentAttempts AssessmentAttempt[]

  verifiedByTpo TPOProfile? @relation("TPOVerifiedStudents", fields: [verifiedByTpoId], references: [id], onDelete: SetNull)
}

model Address {
  id String @id @default(uuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  pincode      String?

  isPermanent Boolean @default(false)
  isCurrent   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Education {
  id String @id @default(uuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  level EducationLevel

  institution    String?
  board          String?
  university     String?
  course         String?
  specialization String?

  startYear Int?
  endYear   Int?

  percentage Float?
  cgpa       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id String @id @default(uuid())

  name     String  @unique
  category String?

  students StudentSkill[]

  createdAt DateTime @default(now())
}

model StudentSkill {
  id String @id @default(uuid())

  studentId String
  skillId   String

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  proficiency Int?

  createdAt DateTime @default(now())

  @@unique([studentId, skillId])
}

model Project {
  id String @id @default(uuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title       String
  description String?

  technologies String[]
  githubUrl    String?
  liveUrl      String?

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id String @id @default(uuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  type ExperienceType

  companyName String
  role        String?

  description String?

  startDate DateTime?
  endDate   DateTime?

  isCurrent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Certification {
  id String @id @default(uuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  name          String
  issuingOrg    String?
  credentialId  String?
  credentialUrl String?

  issueDate  DateTime?
  expiryDate DateTime?

  createdAt DateTime @default(now())
}

model Achievement {
  id String @id @default(uuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title       String
  description String?
  date        DateTime?

  createdAt DateTime @default(now())
}

model SocialLink {
  id String @id @default(uuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  platform String
  url      String

  createdAt DateTime @default(now())

  @@unique([studentId, platform])
}

model Resume {
  id String @id @default(uuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  fileUrl  String
  fileName String?

  status ResumeStatus @default(UPLOADED)

  atsScore Float?

  uploadedAt DateTime  @default(now())
  analyzedAt DateTime?
}

model PlacementPreference {
  id String @id @default(uuid())

  studentId String         @unique
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  preferredRoles     String[]
  preferredLocations String[]

  expectedSalaryMin Float?
  expectedSalaryMax Float?

  willingToRelocate Boolean @default(false)

  preferredWorkMode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecruiterProfile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String?
  designation String?
  companyName String?
  phone       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TPOProfile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String?
  designation String?
  department  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verifiedStudents StudentProfile[] @relation("TPOVerifiedStudents")
  assessments      Assessment[]
}

model AssessmentBlueprint {
  id                 String            @id @default(uuid())
  type               AssessmentType
  title              String
  description        String?
  numberOfQuestions  Int
  durationMinutes    Int
  difficulty         Difficulty
  aptitudeSections   AptitudeSection[]
  dsaTopics          String[]
  sourcePatterns     Json?
  aiGenerationConfig Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  assessment Assessment?
}

model Assessment {
  id              String           @id @default(uuid())
  blueprintId     String           @unique
  createdByTpoId  String
  type            AssessmentType
  title           String
  description     String?
  durationMinutes Int
  difficulty      Difficulty
  status          AssessmentStatus @default(DRAFT)
  instructions    String?
  startsAt        DateTime?
  endsAt          DateTime?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  blueprint    AssessmentBlueprint  @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  createdByTpo TPOProfile           @relation(fields: [createdByTpoId], references: [id], onDelete: Restrict)
  questions    AssessmentQuestion[]
  attempts     AssessmentAttempt[]

  @@index([createdByTpoId])
  @@index([status])
  @@index([type])
}

model AssessmentQuestion {
  id             String                   @id @default(uuid())
  assessmentId   String
  questionNumber Int
  type           AssessmentQuestionType
  section        AptitudeSection?
  difficulty     Difficulty
  title          String
  description    String?
  options        Json?
  correctAnswer  Json?
  explanation    String?
  codingLanguage String?
  starterCode    Json?
  constraints    String?
  topics         String[]
  sourceMetadata Json?
  status         AssessmentQuestionStatus @default(GENERATED)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  assessment  Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  testCases   TestCase[]
  answers     AssessmentAnswer[]
  submissions CodingSubmission[]

  @@unique([assessmentId, questionNumber])
  @@index([assessmentId])
  @@index([type])
  @@index([section])
}

model TestCase {
  id             String   @id @default(uuid())
  questionId     String
  input          Json
  expectedOutput Json
  isHidden       Boolean  @default(true)
  weight         Float    @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model AssessmentAttempt {
  id                 String                  @id @default(uuid())
  assessmentId       String
  studentId          String
  status             AssessmentAttemptStatus
  submissionReason   SubmissionReason?
  startedAt          DateTime?
  submittedAt        DateTime?
  expiresAt          DateTime?
  score              Float?
  maxScore           Float?
  percentage         Float?
  proctoringWarnings Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  assessment        Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student           StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers           AssessmentAnswer[]
  codingSubmissions CodingSubmission[]
  proctoringSession ProctoringSession?

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([assessmentId])
  @@index([status])
}

model AssessmentAnswer {
  id         String    @id @default(uuid())
  attemptId  String
  questionId String
  answer     Json?
  isCorrect  Boolean?
  score      Float?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  attempt  AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model CodingSubmission {
  id              String                 @id @default(uuid())
  attemptId       String
  questionId      String
  language        String
  sourceCode      String
  status          CodingSubmissionStatus @default(PENDING)
  score           Float?
  executionTimeMs Int?
  memoryKb        Int?
  compilerOutput  String?
  submittedAt     DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  attempt  AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
}

model ProctoringSession {
  id                String    @id @default(uuid())
  attemptId         String    @unique
  cameraGranted     Boolean   @default(false)
  microphoneGranted Boolean   @default(false)
  fullscreenActive  Boolean   @default(false)
  warningCount      Int       @default(0)
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  events  ProctoringEvent[]
}

model ProctoringEvent {
  id         String              @id @default(uuid())
  sessionId  String
  type       ProctoringEventType
  metadata   Json?
  occurredAt DateTime            @default(now())
  createdAt  DateTime            @default(now())

  session ProctoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([occurredAt])
}
